
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# NordVPN IKEv2 profile generator: defensive, since the default output dir
# (Library/Application Support/vpn-switch) is outside the repo anyway.
*.mobileconfig
config/nord-ikev2/*.env

# macOS
.DS_Store

# Captured evidence from bin/dns-snapshot.sh / dns-watch.sh: local only, contains
# tailnet/LAN details. Never committed (history purged 2026-09-05).
snapshots/

# lan-hosts.conf is the user-owned real hosts file (dns-config-c4r): the repo
# ships config/lan-hosts.conf.example instead. A local, real copy here in the
# checkout is fine and expected for development (scripts resolve it via
# lib/lan-hosts.sh's repo-relative path) -- it is just never tracked/committed.
config/lan-hosts.conf
